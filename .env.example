# ---------------------------------------------------------------
# Supabase (Project Settings → API Keys)
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publique : « anon » (legacy) ou « publishable » (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : « service_role » (legacy) ou « secret » (sb_secret_…).
# Ne jamais la mettre dans une variable NEXT_PUBLIC_ ni la partager.
SUPABASE_SERVICE_ROLE_KEY=

# Adresse publique du site (liens des e-mails de confirmation).
# Facultatif sur Vercel : l'adresse du projet Vercel est utilisée par défaut.
SITE_URL=http://localhost:3000

# ---------------------------------------------------------------
# Paiements
# ---------------------------------------------------------------
# « simulation » (aucun argent ne circule) ou « pawapay ».
# Si vide : pawapay dès que PAWAPAY_API_TOKEN est renseigné, sinon simulation.
PAYMENT_PROVIDER=simulation
# Jeton d'API pawaPay (tableau de bord pawaPay → API Tokens)
PAWAPAY_API_TOKEN=
# « sandbox » pour les tests, « production » pour encaisser réellement
PAWAPAY_ENVIRONMENT=sandbox
# En production, la simulation est refusée sauf si ceci vaut true (démo publique)
ALLOW_SIMULATED_PAYMENTS=false
