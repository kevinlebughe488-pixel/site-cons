# ---------------------------------------------------------------
# Supabase (Project Settings → API Keys)
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publique : « anon » (legacy) ou « publishable » (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : « service_role » (legacy) ou « secret » (sb_secret_…).
# Ne jamais la mettre dans une variable NEXT_PUBLIC_ ni la partager.
SUPABASE_SERVICE_ROLE_KEY=

# Adresse publique du site. Facultatif sur Vercel : l'adresse du projet est utilisée par défaut.
SITE_URL=http://localhost:3000

# ---------------------------------------------------------------
# Connexion avec Google (facultatif : sans ces deux variables, le bouton reste affiché
# mais un clic indique que la connexion avec Google n'est pas encore disponible)
# ---------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# URI de redirection autorisée : <SITE_URL>/auth/google/callback
# Ne PAS activer Google dans Supabase (Authentication → Providers) : le site s'en charge.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------
# SMS (codes de vérification : inscription, connexion, mot de passe oublié)
# ---------------------------------------------------------------
# « simulation » (aucun SMS, le code s'affiche à l'écran) ou « twilio ».
# Si vide : twilio dès que TWILIO_ACCOUNT_SID est renseigné, sinon simulation.
SMS_PROVIDER=simulation
# Compte Twilio (console.twilio.com → Account Info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Expéditeur : un numéro Twilio (+1…) ou un nom alphanumérique autorisé (ex. TRIBUNE),
# ou bien un Messaging Service (MG…), qui choisit lui-même l'expéditeur.
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# En production, la simulation est refusée sauf si ceci (ou ALLOW_SIMULATED_PAYMENTS) vaut true
ALLOW_SIMULATED_SMS=false

# ---------------------------------------------------------------
# Paiements
# ---------------------------------------------------------------
# « simulation » (aucun argent ne circule) ou « pawapay ».
# Si vide : pawapay dès que PAWAPAY_API_TOKEN est renseigné, sinon simulation.
PAYMENT_PROVIDER=simulation
# Jeton d'API pawaPay (tableau de bord pawaPay → API Tokens)
PAWAPAY_API_TOKEN=
# « sandbox » pour les tests, « production » pour encaisser réellement
PAWAPAY_ENVIRONMENT=sandbox
# En production, la simulation est refusée sauf si ceci vaut true (démo publique)
ALLOW_SIMULATED_PAYMENTS=false
